{
  "schemaVersion": 1,
  "id": "viafabricplus",
  "version": "${version}",
  "name": "ViaFabricPlus OpenZen 766",
  "description": "ViaFabricPlus for Fabric 1.20.1 with the original cross-version UI and Minecraft 1.20.5/1.20.6 protocol 766 support.",
  "authors": ["FlorianMichael/EnZaXD", "ViaFabricPlus contributors", "Mizulune/OpenZen maintainers"],
  "contact": {
    "sources": "https://github.com/ViaVersion/ViaFabricPlus"
  },
  "license": "GPL-v3",
  "icon": "assets/viafabricplus/icon.png",
  "environment": "client",
  "entrypoints": {
    "modmenu": [
      "de.florianmichael.viafabricplus.integration.ModMenuImpl"
    ]
  },
  "mixins": [
    "viafabricplus.mixins.json"
  ],
  "accessWidener": "viafabricplus.accesswidener",
  "depends": {
    "fabricloader": ">=0.14.21",
    "fabric-api": ">=0.83.0+1.20.1",
    "minecraft": "~1.20.1",
    "java": ">=17"
  },
  "breaks": {
    "viafabric": "*",
    "memoryleakfix": "<=1.1.0",
    "krypton": "<=0.2.2"
  },
  "conflicts": {
    "dashloader": "*",
    "armorskin": "*"
  },
  "provides": ["mizulune-viafabricplus"]
}
